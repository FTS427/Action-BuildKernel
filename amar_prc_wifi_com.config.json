[
  {
    "kernelSource": {
      "name": "neko",
      "repo": "https://codeberg.org/QuantumLS-Studio/android_kernel_lenovo_amar_prc_wifi_com",
      "branch": "main",
      "device": "amar_prc_wifi_com",
      "defconfig": "amar_prc_wifi_com_defconfig"
    },
    "toolchains": [
      {
        "name": "clang",
        "repo": "https://github.com/MizProject/clang-r416183b",
        "branch": "main",
        "binaryEnv": ["./bin"]
      },
      {
        "name": "gcc",
        "repo": "https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9",
        "branch": "lineage-18.1",
        "binaryEnv": ["./bin"]
      }
    ],
    "params": {
      "CC": "clang",
      "externalCommands": {
        "CROSS_COMPILE": "aarch64-linux-android-",
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "LD": "ld.lld",
        "NM": "llvm-nm",
        "AR": "llvm-ar",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "STRIP": "llvm-strip"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "custom": {
        "repo": "https://github.com/FTS427/AnyKernel3",
        "branch": "master"
      }
    },
    "enableBakaSU": true
  }
]
